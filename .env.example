# Web Vite — landing, /signin, /dashboard, /admin
# Cloudflare Pages: add the same VITE_* keys under Settings → Environment variables (see CLOUDFLARE.md).

# Origin of the API Worker (workers/api). Local dev falls back to http://localhost:8787 (`npm run dev` in workers/api).
VITE_API_URL=https://api.receiptcycle.com

# Google OAuth *web* client id for "Continue with Google" (Google Cloud Console → Credentials → Web application;
# add your site origin, e.g. https://receiptcycle.com and http://localhost:8080, under Authorized JavaScript origins).
# The same id must be set on the Worker as GOOGLE_WEB_CLIENT_ID.
# VITE_GOOGLE_WEB_CLIENT_ID=257702962892-m2m0terd11tbn8049umc5bltp5sjqqr1.apps.googleusercontent.com
# Optional — App Store / Play Store links on the landing page (defaults exist in code)
# VITE_APP_STORE_URL=https://apps.apple.com/app/...
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# Optional — footer social links (defaults: x.com/receiptcycle, instagram.com/receiptcycle)
# VITE_SOCIAL_X_URL=https://x.com/yourhandle
# VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/yourhandle

# Payments (Polar): there is nothing to set here. The API creates checkouts. Polar settings are Worker variables/secrets
# on receipt-cycle-api: POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET, POLAR_ORGANIZATION_ID, POLAR_ORG_SLUG,
# POLAR_MONTHLY_PRODUCT_ID, POLAR_YEARLY_PRODUCT_ID, POLAR_FREE_PRODUCT_ID.

# Server-side settings (Polar webhook, Google, email, AI keys, Better Auth secret) are Worker secrets, not Vite vars.
# See workers/api/.dev.vars.example. Polar webhook URL: https://<YOUR_API_ORIGIN>/api/webhooks/polar
