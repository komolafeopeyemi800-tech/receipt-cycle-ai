# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Bun lockfiles — this repo uses npm (package-lock.json) only
bun.lock
bun.lockb

# Environment (secrets) — never commit
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local build outputs that must never be committed (an APK is 200 MB; GitHub rejects files over 100 MB)
apps/mobile/*.apk
apps/mobile/dist-*/
apps/android-native/**/*.apk
