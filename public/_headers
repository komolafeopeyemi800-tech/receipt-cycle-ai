# Cloudflare Pages (and Netlify-compatible); copied to dist/ by Vite.
# Mirrors cache + security headers from netlify.toml.

# Pages always revalidate so a visitor never gets an old page that points at deleted files.
/*
  Cache-Control: no-cache

# Hashed files never change, so they can be kept for a year.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=300

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=300

/llms.txt
  ! Cache-Control
  Cache-Control: public, max-age=300

/og-image.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
