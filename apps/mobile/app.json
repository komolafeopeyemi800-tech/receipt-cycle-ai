{
  "expo": {
    "name": "Receipt Cycle Invoice Manager",
    "slug": "receipt-cycle-mobile",
    "version": "1.0.2",
    "scheme": [
      "receiptcycle",
      "com.receiptcycle.mobile"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#149184"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSMicrophoneUsageDescription": "Receipt Cycle uses the microphone when you choose voice entry to prepare a transaction for your review."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#149184",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.receiptcycle.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Receipt Cycle to scan receipts with your camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-background-fetch",
      "expo-font",
      "expo-mail-composer",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#149184", "defaultChannel": "reminders" }]
    ],
    "extra": {
      "eas": {
        "projectId": "679b7af6-1ce5-4452-9056-6f935e390189"
      }
    }
  }
}
