# API Worker (required for the app). A phone cannot reach "localhost": while developing use your computer's LAN address
# (e.g. http://192.168.1.20:8787, `npm run dev -- --ip 0.0.0.0` in workers/api); in production use the deployed origin.
EXPO_PUBLIC_API_URL=https://api.receiptcycle.com

# Public website origin (used in password-reset links)
# EXPO_PUBLIC_WEB_APP_URL=https://receiptcycle.com

# Marketing — opened from Settings → Upgrade to premium
EXPO_PUBLIC_PRICING_URL=https://receiptcycle.app/pricing

# Whop checkout (same plan URLs as web; set when products are live)
# EXPO_PUBLIC_WHOP_CHECKOUT_FREE_URL=https://whop.com/checkout/plan_...
# EXPO_PUBLIC_WHOP_CHECKOUT_MONTHLY_URL=https://whop.com/checkout/plan_...
# EXPO_PUBLIC_WHOP_CHECKOUT_YEARLY_URL=https://whop.com/checkout/plan_...
# EXPO_PUBLIC_WHOP_MANAGE_URL=https://whop.com/hub/...

# Google (mobile): same OAuth client IDs are used for Drive backup and “Sign in with Google”.
# In Google Cloud Console: enable Google Drive API, create iOS + Android OAuth clients, add redirect URIs:
#   receiptcycle://google-drive-oauth
#   receiptcycle://google-signin
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com

# Worker secrets (workers/api): verify Google ID tokens from the app
# GOOGLE_IOS_CLIENT_ID=same-as-ios-client-id.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=same-as-android-client-id.apps.googleusercontent.com

# Password reset emails use Resend: set RESEND_API_KEY and RESEND_FROM_EMAIL as Worker secrets.

# Do NOT put GEMINI_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY here — set them as Worker secrets (wrangler secret put).
# Primary scan: OPENAI_API_KEY (recommended). Gemini fallback: OPENROUTER_API_KEY or GEMINI_API_KEY.
# See workers/api/.dev.vars.example
